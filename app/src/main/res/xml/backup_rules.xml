<?xml version="1.0" encoding="utf-8"?><!--
   FieldProof backup rules.

   Backup is disabled at the manifest level (android:allowBackup="false") so
   this file exists only as defence in depth: it explicitly excludes every
   domain that could carry inspection data (database rows, captured evidence
   photos, notes and preferences) from the legacy full-backup transport.

   Evidence encryption keys live in the Android Keystore and never leave the
   device, so a restored database or file would be undecryptable anyway.

   See https://developer.android.com/guide/topics/data/autobackup for details.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
