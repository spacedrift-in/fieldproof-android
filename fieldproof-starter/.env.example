# Copy to `.env` and fill in real values. NEVER commit `.env`.
# In production prefer your platform's secret manager over a file on disk.

# --- Core ------------------------------------------------------------------
APP_ENV=production
APP_VERSION=0.3.0
DOCS_ENABLED=false

# Managed PostgreSQL connection string (sslmode=require in production).
DATABASE_URL=postgresql+psycopg://fieldproof:CHANGE_ME@db:5432/fieldproof

# --- Evidence object storage ----------------------------------------------
EVIDENCE_STORAGE_BACKEND=s3
EVIDENCE_S3_BUCKET=fieldproof-evidence
EVIDENCE_S3_REGION=us-east-1
# For MinIO / S3-compatible services set the endpoint; leave blank for AWS S3.
EVIDENCE_S3_ENDPOINT_URL=
EVIDENCE_S3_USE_SSL=true
EVIDENCE_S3_PREFIX=fieldproof
# "AES256" (SSE-S3) or "aws:kms" (set EVIDENCE_S3_KMS_KEY_ID).
EVIDENCE_S3_SSE=aws:kms
EVIDENCE_S3_KMS_KEY_ID=
# Lifecycle: transition to cheaper storage (days; 0 disables). Transitions are
# prefix-scoped and non-destructive.
EVIDENCE_S3_LIFECYCLE_TRANSITION_DAYS=30
EVIDENCE_S3_LIFECYCLE_GLACIER_DAYS=90
# Expiration is TAG-SCOPED: only objects tagged `fieldproof-retention=eligible`
# by the retention sweep are ever expired, so active work and legal holds are
# never removed. 0 disables expiry.
EVIDENCE_S3_LIFECYCLE_DAYS=2555
# Let the app write the lifecycle configuration at startup. Default `false`:
# provision lifecycle via infrastructure management (Terraform/CloudFormation)
# so app startup never clobbers unrelated bucket rules. When enabled, the app
# merges only its own two rules and preserves all others.
EVIDENCE_S3_MANAGE_LIFECYCLE=false
MAX_EVIDENCE_BYTES=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/heic,image/gif

# Credentials are read from the standard AWS env vars by boto3 (never commit):
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# AWS_SESSION_TOKEN=            # when using temporary credentials

# --- Upload scanning -------------------------------------------------------
# "noop" (dev) or "clamav" (production).
MALWARE_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
MALWARE_SCAN_FAIL_CLOSED=true

# --- Tenancy / edge security ----------------------------------------------
DEFAULT_TENANT=demo
# --- Retention / deletion -------------------------------------------------
# Days after which APPROVED evidence is purged by the sweep (0 = disabled).
EVIDENCE_RETENTION_DAYS=0
# Required by POST /api/v1/maintenance/retention; leave blank to disable (503).
RETENTION_ADMIN_TOKEN=
# Comma-separated exact origins; never use "*" with credentials.
CORS_ALLOWED_ORIGINS=https://app.fieldproof.example
CORS_ALLOW_CREDENTIALS=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
# Cap the number of distinct rate-limit keys held in memory (KL-032).
RATE_LIMIT_MAX_KEYS=10000
# Only set when running behind a trusted reverse proxy that always overwrites
# this header with the real client IP (e.g. `X-Real-IP`). Empty = use the socket
# peer address. Never trust it from an untrusted edge.
RATE_LIMIT_CLIENT_IP_HEADER=
# Do NOT enable unless every request is forced to a single tenant at the edge:
# the limiter key includes the tenant, so an unverified `X-Tenant-Id` would let
# a caller rotate tenants to evade the limit (KL-032).
RATE_LIMIT_TRUST_TENANT_HEADER=false

# --- Observability ---------------------------------------------------------
# Expose Prometheus metrics on GET /metrics (KL-034). Leave the token blank to
# keep the endpoint open inside a private network; set it to require
# `X-Admin-Token` on every scrape.
METRICS_ENABLED=true
METRICS_ADMIN_TOKEN=

# --- Schema management (KL-003) --------------------------------------------
# `create_all` runs only outside production. In production set both to `false`
# and apply migrations with the dedicated `migrate` service (see deployment.md).
AUTO_CREATE_SCHEMA=true
RUN_MIGRATIONS_ON_START=false

# --- MinIO (compose only; the app itself talks S3) ------------------------
MINIO_ROOT_USER=fieldproof
MINIO_ROOT_PASSWORD=CHANGE_ME
POSTGRES_USER=fieldproof
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=fieldproof
